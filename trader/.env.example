# Environment variables for trading system
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it will be gitignored

# ============================================================================
# REVOLUT X CREDENTIALS (REQUIRED)
# ============================================================================

# Your Revolut X API Key
# Get this from: Revolut X Account > Profile > API Keys
REVOLUT_API_KEY=your-revolut-api-key-here

# Path to your Ed25519 private key file
# Default: ~/.config/revolut-x/private.pem
# On Windows: %APPDATA%\revolut-x\private.pem
REVOLUT_PRIVATE_KEY_PATH=~/.config/revolut-x/private.pem

# ============================================================================
# OPENAI CREDENTIALS (REQUIRED)
# ============================================================================

# Your OpenAI API Key
# Get this from: https://platform.openai.com/api/keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================================
# TRADING MODE & PARAMETERS
# ============================================================================

# Trading mode: 'paper' (simulation) or 'live' (real money)
# ALWAYS start with 'paper' to test
# Default: paper
REVX_TRADER_MODE=paper

# Maximum position size as % of portfolio per trade
# Default: 5 (risk max 5% per trade)
# Conservative: 2-3%, Aggressive: 5-10%
REVX_MAX_POSITION_SIZE=5

# Maximum daily loss in USD
# If daily losses exceed this, stop trading for the day
# Default: 500
REVX_MAX_DAILY_LOSS=500

# Minimum risk/reward ratio to accept a trade
# Only trade if reward >= risk * this value
# Default: 1.5 (need $1.50 reward for $1.00 risk)
# Conservative: 2.0, Aggressive: 1.2
REVX_MIN_RR=1.5

# Minimum win probability (0-1) to accept a trade
# AI estimates probability of success
# Default: 0.55 (55% confidence)
# Conservative: 0.65, Aggressive: 0.50
REVX_MIN_WIN_PROB=0.55

# ============================================================================
# SYSTEM PARAMETERS
# ============================================================================

# How often to check for trading opportunities (milliseconds)
# Default: 60000 (60 seconds)
# Fast: 30000 (30 sec), Slow: 120000 (2 min)
REVX_POLL_INTERVAL_MS=60000

# Path to SQLite trade history database
# Default: ./trader-history.db
REVX_DB_PATH=./trader-history.db
